# ============================================================================
# UiPath Mobile Test Autopilot — server environment
# Copy to server/.env (or export in your shell). Everything is OPTIONAL:
# with nothing set, the app runs in SIMULATED mode end-to-end.
# Per-session values entered in the UI override these defaults.
# ============================================================================

# --- Server ---
PORT=8787

# --- UiPath connection (defaults; can be overridden per-session in the UI) ---
UIPATH_BASE_URL=https://cloud.uipath.com
UIPATH_ORG_NAME=
UIPATH_TENANT_NAME=

# --- UiPath auth: option A — client credentials (External Application) ---
# The secret stays server-side and is exchanged at /identity_/connect/token.
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
# Space-delimited scopes. OR.Execution / OR.Default typically cover the LLM Gateway.
UIPATH_SCOPE=OR.Execution

# --- UiPath auth: option B — paste a bearer token or PAT ---
UIPATH_BEARER_TOKEN=

# --- UiPath LLM Gateway ---
# Model id as known to your tenant's LLM Gateway. Selectable in the UI dropdown;
# e.g. gpt-4o-mini-2024-07-18, gpt-4o, anthropic.claude-3-5-sonnet-20240620,
# gemini-2.5-pro, etc.
UIPATH_LLM_MODEL=gpt-4o-mini-2024-07-18
# Override the gateway base segment if your tenant uses a non-default path.
# Leave blank to auto-try: llmgateway_ -> orchestrator_/llm -> agenthub_/llm
UIPATH_LLM_BASE_PATH=
UIPATH_LLM_API_VERSION=2024-10-21

# --- Device farm defaults (can be overridden per-session in the UI) ---
# Provider: browserstack | saucelabs
DEVICE_FARM_PROVIDER=browserstack

# BrowserStack App Automate
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Sauce Labs (region: us-west-1 | eu-central-1 | us-east-4 ...)
SAUCE_USERNAME=
SAUCE_ACCESS_KEY=
SAUCE_REGION=us-west-1

# ============================================================================
# UiPath Browser Test Autopilot - server environment
# Copy to server/.env or export in your shell. Everything is optional.
# Per-session values entered in the UI override these defaults.
# ============================================================================

# --- Server ---
PORT=8787

# --- UiPath connection ---
UIPATH_BASE_URL=https://cloud.uipath.com
UIPATH_ORG_NAME=
UIPATH_TENANT_NAME=

# Option A: client credentials (External Application)
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
UIPATH_SCOPE=OR.Execution

# Option B: bearer token or PAT
UIPATH_BEARER_TOKEN=

# --- UiPath LLM Gateway ---
UIPATH_LLM_MODEL=gpt-4o-mini-2024-07-18
# Leave blank to auto-try: llmgateway_ -> orchestrator_/llm -> agenthub_/llm
UIPATH_LLM_BASE_PATH=
UIPATH_LLM_API_VERSION=2024-10-21

# --- Local browser automation defaults ---
BROWSER_NAME=edge
BROWSER_HEADLESS=false
BROWSER_VIEWPORT_WIDTH=1440
BROWSER_VIEWPORT_HEIGHT=900

# Browser startup timeout and parallel run cap
BROWSER_CONNECT_TIMEOUT_MS=300000
MAX_PARALLEL_SESSIONS=0
LIVE_FRAME_MS=1500
